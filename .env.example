# Application identity
APP_NAME=Chat | Cipolatti
APP_URL=https://chat.example.com
APP_LOGO=/cipolatti-icon.png
APP_FAVICON=/favicon-chat-cipolatti-v3.ico
APP_PRIMARY_COLOR=#0f7a55
COMPANY_NAME=CHANGE_ME
COMPANY_TIMEZONE=America/Sao_Paulo

# Runtime
NODE_ENV=production
PORT=3002
KALION_DATA_DIR=/var/lib/kalion-connect
PUBLIC_BASE_URL=https://chat.example.com
KALION_ALLOWED_ORIGINS=https://chat.example.com
KALION_INTERNAL_API_KEY=CHANGE_ME
KALION_ENCRYPTION_KEY=CHANGE_ME

# Web Push / PWA notifications
VAPID_PUBLIC_KEY=CHANGE_ME
VAPID_PRIVATE_KEY=CHANGE_ME
VAPID_SUBJECT=mailto:ti@example.com

# Sessions / cookies
SESSION_SECRET=CHANGE_ME
REMEMBER_AD_DAYS=30
REMEMBER_LOCAL_HOURS=12
AD_SESSION_REVALIDATION_SECONDS=900

# Active Directory / LDAPS
AD_AUTH_ENABLED=true
AD_LDAPS_URL=ldaps://ad.example.local:636
AD_DOMAIN=example.local
AD_NETBIOS=EXAMPLE
AD_BASE_DN=DC=example,DC=local
AD_SERVICE_BIND_DN=CN=service-account,OU=Service Accounts,DC=example,DC=local
AD_SERVICE_PASSWORD=CHANGE_ME
AD_GROUP_USUARIOS_DN=CN=CHAT-USUARIOS,OU=Groups,DC=example,DC=local
AD_GROUP_GESTORES_DN=CN=CHAT-GESTORES,OU=Groups,DC=example,DC=local
AD_GROUP_ADMINISTRADORES_DN=CN=CHAT-ADMINISTRADORES,OU=Groups,DC=example,DC=local

# Uploads and storage
UPLOAD_DIRECTORY=/var/lib/kalion-connect/uploads
MAX_UPLOAD_SIZE=10485760
DATABASE_URL=

# Optional legacy / integration values. Leave blank unless the installation uses them.
WEBHOOK_URL=
META_GRAPH_VERSION=v25.0
META_APP_SECRET=CHANGE_ME
WHATSAPP_ACCESS_TOKEN=CHANGE_ME
WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME
WHATSAPP_WABA_ID=CHANGE_ME
WHATSAPP_BUSINESS_ACCOUNT_ID=CHANGE_ME
WHATSAPP_VERIFY_TOKEN=CHANGE_ME
WHATSAPP_MOCK_MODE=false
WHATSAPP_MOCK_REJECT_PHONE=

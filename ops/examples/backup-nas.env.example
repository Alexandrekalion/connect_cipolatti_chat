# NAS backup copy configuration example. Copy to /etc/kalion-connect/backup-nas.env and fill locally.
NAS_ENABLED=true
NAS_METHOD=smbclient
NAS_SMB_SHARE=//NAS_HOST/backup
NAS_SMB_SUBDIR=chat
NAS_SMB_CREDENTIALS=/root/kalion-connect-secrets/nas-smb.credentials
KALION_BACKUP_ALLOWED_NAS_SHARE=//NAS_HOST/backup
KALION_BACKUP_ALLOWED_NAS_SUBDIR=chat
KALION_BACKUP_RETENTION_DAYS=15
KALION_BACKUP_RETENTION_APPLY=false
